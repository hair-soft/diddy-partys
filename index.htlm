
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#080c18">
  <title>HOUSE23 | Hausparty</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="style.css">

  <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.3/build/qrcode.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
</head>

<body>
  <header class="topbar">
    <a class="logo" href="#">HOUSE<span>23</span></a>
    <span class="date-pill">23. OKTOBER 2026</span>
  </header>

  <main>
    <section class="hero">
      <div class="eyebrow"><span class="pulse"></span> PRIVATE HOUSE PARTY</div>

      <h1>LET'S<br><span>PARTY.</span></h1>
      <p class="hero-description">
        Gute Leute. Gute Musik. Erinnerungen für immer.
      </p>

      <div class="countdown" id="countdown">
        <div><strong id="days">00</strong><small>TAGE</small></div>
        <div><strong id="hours">00</strong><small>STUNDEN</small></div>
        <div><strong id="minutes">00</strong><small>MINUTEN</small></div>
        <div><strong id="seconds">00</strong><small>SEKUNDEN</small></div>
      </div>

      <a href="#fotos" class="hero-button">PARTY FOTOS <span>↘</span></a>
    </section>

    <section class="section" id="fotos">
      <div class="section-label">01 / SHARE THE MOMENTS</div>
      <h2>Dein Abend.<br><span>Unsere Erinnerungen.</span></h2>
      <p class="section-description">
        Mach Fotos, lade sie hoch und teile deine Momente mit allen.
        Ohne Registrierung.
      </p>

      <div class="upload-grid">
        <div class="panel upload-panel">
          <div class="big-icon">📸</div>
          <h3>Teile deine Fotos</h3>
          <p>Wähle ein oder mehrere Bilder von deinem Handy aus.</p>

          <input
            id="fileInput"
            type="file"
            accept="image/jpeg,image/png,image/webp,image/heic"
            multiple
            hidden
          >

          <button id="uploadBtn" class="primary-button">
            FOTOS AUSWÄHLEN <span>↗</span>
          </button>

          <div id="uploadStatus" class="status" role="status" aria-live="polite"></div>
          <div class="privacy-note">
            Bitte lade nur Fotos hoch, deren Veröffentlichung für die abgebildeten Personen in Ordnung ist.
          </div>
        </div>

        <div class="panel qr-panel">
          <div class="qr-frame">
            <canvas id="qr"></canvas>
          </div>
          <h3>SCAN & SHARE</h3>
          <p>Scanne den QR-Code mit deiner Handykamera.</p>
          <button id="copyLinkBtn" class="secondary-button">PARTY-LINK KOPIEREN</button>
          <div id="copyStatus" class="status"></div>
        </div>
      </div>
    </section>

    <section class="section gallery-section">
      <div class="section-label">02 / THE GALLERY</div>

      <div class="gallery-heading">
        <h2>Unsere<br><span>Moments.</span></h2>
        <span class="live-indicator"><i></i> GALERIE</span>
      </div>

      <div id="gallery" class="gallery"></div>

      <div id="emptyState" class="empty-state">
        <div class="empty-icon">✦</div>
        <h3>Noch keine Fotos</h3>
        <p>Sei der Erste und teile einen Moment mit uns.</p>
      </div>

      <button id="refreshBtn" class="secondary-button refresh-button">
        GALERIE AKTUALISIEREN ↻
      </button>
    </section>
  </main>

  <footer>
    <a class="logo" href="#">HOUSE<span>23</span></a>
    <p>23.10.2026 · GOOD VIBES, GREAT MEMORIES.</p>
  </footer>

  <div id="lightbox" class="lightbox" hidden>
    <button id="closeLightbox" class="close-lightbox" aria-label="Bild schließen">×</button>
    <img id="lightboxImage" src="" alt="Partyfoto in Vollbildansicht">
  </div>

  <script src="app.js"></script>
</body>
</html>
